# ==========================================
# TIZLY BACKEND CONFIGURATION
# ==========================================

# 1. DATABASE (Supabase PostgreSQL)
# Get from: Supabase Dashboard -> Connect (top bar) -> URI
# Format: postgresql://postgres.[project-ref]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Leave commented out to use local SQLite development database
# SUPABASE_DB_URL=postgresql://postgres.yourprojectref:yourpassword@aws-0-region.pooler.supabase.com:6543/postgres

# 2. SUPABASE STORAGE (For image uploads of products and community posts)
# Get from: Supabase Dashboard -> Settings -> Data API / API Keys
# SUPABASE_URL=https://yourprojectref.supabase.co
# SUPABASE_KEY=eyJhbGciOi... (anon key or service_role key)
# SUPABASE_BUCKET=tizly-media

# 3. ADMIN CONFIGURATION (Hidden from source code)
# Comma-separated Firebase UIDs that will automatically receive Admin status
ADMIN_UIDS=your_firebase_uid_1,your_firebase_uid_2
ADMIN_REGISTRATION_CODE=TIZLY_ADMIN_2026

# 4. FIREBASE AUTHENTICATION (Service Account)
# Option A: Path to service account file
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json

# Option B: Raw JSON string (Useful for Render Web Service environment variables)
# FIREBASE_CREDENTIALS_JSON={"type":"service_account","project_id":"tizly-9da17",...}

# 5. FLASK CONFIGURATION
SECRET_KEY=tizly-secret-key-2026
PORT=5000
